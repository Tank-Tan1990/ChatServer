# ChatServer 环境变量配置
# 复制此文件为 .env 并填写真实值

# ========== 核心配置 ==========
# 服务端口（默认 8080）
PORT=8080

# ========== 数据库配置 ==========
# MySQL 连接字符串
DATABASE_URL=mysql://chatuser:CHANGE_ME@127.0.0.1:3306/chat_server

# ========== Redis 配置 ==========
REDIS_URL=redis://127.0.0.1:6379

# ========== JWT 配置（生产环境必须修改！） ==========
# JWT 签名密钥（至少 32 字符，建议使用随机字符串）
# 生成方式：openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 限流配置 ==========
# 每分钟允许请求数（0 = 禁用）
RATE_LIMIT_RPM=120

# ========== 日志配置 ==========
# 日志级别: trace, debug, info, warn, error
RUST_LOG=info

# ========== HTTPS 配置（可选） ==========
# 启用 HTTPS（需要提供证书）
ENABLE_HTTPS=false
HTTPS_PORT=8443
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key

# ========== 性能配置 ==========
# 最大连接池大小
MAX_DB_CONNECTIONS=20

# Redis 连接池大小
REDIS_POOL_SIZE=10

# Tokio worker 线程数（0 = 自动）
WORKER_THREADS=0
